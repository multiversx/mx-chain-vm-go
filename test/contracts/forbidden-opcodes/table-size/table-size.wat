(module
  (type $void (func))
  (type $finish(func (param i64)))
  (import "env" "int64finish" (func $int64finish (type $finish)))
  (table $tab 1 funcref)
  (elem (i32.const 0) $main)
  (func $main (type $void)
    (drop
      (table.size $tab)
    )
    (i64.const 0)
    (call $int64finish)
  )
  (memory $mem 1)
  (export "memory" (memory $mem))
  (export "main" (func $main))
)
